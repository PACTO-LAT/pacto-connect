{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "type-check": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "clean": {
      "cache": false
    },
    "test:e2e": {
      "dependsOn": ["^build"],
      "cache": false,
      "env": [
        "DATABASE_URL",
        "DIRECT_URL",
        "GATEWAY_ADMIN_TOKEN",
        "GATEWAY_SIGNING_SECRET",
        "E2E_GATEWAY_URL",
        "TESTMODE_RELEASE_DELAY_MS",
        "WEBHOOK_BACKOFF_BASE_MS",
        "CI"
      ]
    }
  }
}
