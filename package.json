{
  "name": "pacto-connect",
  "version": "0.0.0",
  "private": true,
  "description": "Embeddable SDK + widget to add Pacto P2P stablecoin buy/sell flows to any site.",
  "packageManager": "npm@11.2.0",
  "workspaces": [
    "packages/*",
    "services/*",
    "apps/*",
    "apps/docs/examples/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:examples": "turbo run dev --filter=@pacto-connect/example-*",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "test": "turbo run test",
    "clean": "turbo run clean",
    "format": "biome format --write .",
    "check": "biome check .",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build && changeset publish",
    "generate:openapi": "tsx scripts/generate-openapi.mts"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "12.1.0",
    "@biomejs/biome": "^2.1.1",
    "@changesets/cli": "^2.27.9",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "next": "^14.2.18",
    "openapi-typescript": "7.13.0",
    "tsx": "4.23.12",
    "turbo": "^2.3.0",
    "typescript": "^5.6.3",
    "vitest": "3.2.6",
    "yaml": "2.9.0"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "next": "^14.2.18"
  },
  "engines": {
    "node": ">=20"
  }
}
