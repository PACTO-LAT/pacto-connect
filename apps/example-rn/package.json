{
  "name": "example-rn",
  "version": "0.0.0",
  "private": true,
  "description": "Minimal Expo app demonstrating @pacto-connect/react-native's checkout sheet, deep-link return, and escrow event hook.",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "lint": "biome check .",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf .expo .turbo"
  },
  "dependencies": {
    "@pacto-connect/core": "*",
    "@pacto-connect/react-native": "*",
    "expo": "^52.0.0",
    "expo-linking": "^7.0.0",
    "expo-status-bar": "^2.0.0",
    "jail-monkey": "^2.8.0",
    "react": "18.3.1",
    "react-native": "0.76.5",
    "react-native-biometrics": "^3.0.1",
    "react-native-keychain": "^8.2.0",
    "react-native-ssl-pinning": "^1.5.1",
    "react-native-webview": "^13.12.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@types/react": "^18.3.12",
    "babel-preset-expo": "^12.0.0",
    "typescript": "^5.6.3"
  }
}
