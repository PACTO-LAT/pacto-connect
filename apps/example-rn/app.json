{
  "expo": {
    "name": "Pacto Connect Example",
    "slug": "pacto-connect-example-rn",
    "scheme": "pacto-example",
    "version": "0.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.pactolat.connect.example",
      "supportsTablet": true,
      "associatedDomains": ["applinks:checkout.pacto.example"]
    },
    "android": {
      "package": "com.pactolat.connect.example",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "checkout.pacto.example",
              "pathPrefix": "/pacto-return"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    }
  }
}
