generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum KeyMode {
  live
  test
}

enum KeyStatus {
  active
  revoked
}

enum CheckoutMode {
  buy
  sell
}

enum SessionStatus {
  active
  expired
  consumed
  revoked
}

enum WebhookStatus {
  enabled
  disabled
}

enum WebhookDeliveryStatus {
  pending
  succeeded
  failed
  dead
}

enum IdempotencyStatus {
  pending
  completed
}

enum SubscriptionStatus {
  active
  past_due
  canceled
}

enum SubscriptionChargeStatus {
  succeeded
  failed
}

enum MerchantStatus {
  active
  disabled
}

enum EscrowStatus {
  pending
  funded
  released
  disputed
  cancelled
  refunded
}

enum EscrowActor {
  buyer
  seller
  merchant
  admin
  system
}

enum DisputeStatus {
  open
  resolved
}

enum DisputeResolution {
  release
  refund
}

enum SettlementPeriodStatus {
  open
  closed
}

enum LedgerDirection {
  credit
  debit
}

enum LedgerEntryKind {
  settlement
  correction
}

enum PayoutRunStatus {
  open
  finalized
}

enum RiskListType {
  allow
  deny
}

enum RiskDecisionOutcome {
  allow
  review
  block
}

model Merchant {
  id        String         @id @default(cuid())
  apiKeyId  String
  apiKey    ApiKey         @relation(fields: [apiKeyId], references: [id])
  name      String
  status    MerchantStatus @default(active)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  sessions         CheckoutSession[]
  webhookEndpoints WebhookEndpoint[]
  webhookEvents    WebhookEvent[]
  subscriptions    Subscription[]
  settlements      MerchantSettlement[]
  settlementPeriods SettlementPeriod[]
  ledgerEntries    LedgerEntry[]
  payoutRuns       PayoutRun[]
  escrows          Escrow[]
  riskSettings     MerchantRiskSettings?
  riskListEntries  MerchantRiskListEntry[]
  riskDecisions    RiskDecision[]

  @@index([apiKeyId])
  @@index([status])
}

model MerchantSettlement {
  id         String   @id @default(cuid())
  merchantId String
  merchant   Merchant @relation(fields: [merchantId], references: [id])
  escrowId   String   @unique
  amount     Float
  asset      String
  settledAt  DateTime @default(now())

  @@index([merchantId])
}

model ApiKey {
  id             String           @id @default(cuid())
  publishableKey String           @unique
  secretKeyHash  String
  secretLast4    String
  mode           KeyMode          @default(test)
  allowedOrigins String[]
  status         KeyStatus        @default(active)
  label          String?
  quoteSpreadBps Int              @default(0)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  checkoutSessions   CheckoutSession[]
  webhookEndpoints   WebhookEndpoint[]
  webhookEvents      WebhookEvent[]
  subscriptions      Subscription[]
  merchants          Merchant[]
  escrows            Escrow[]
  rotatedFromId  String?           @unique
  rotatedFrom    ApiKey?           @relation("KeyRotation", fields: [rotatedFromId], references: [id])
  supersededBy   ApiKey?           @relation("KeyRotation")
  graceExpiresAt DateTime?

  @@index([publishableKey])
  @@index([status])
  @@index([graceExpiresAt])
}

model CheckoutSession {
  id               String        @id @default(cuid())
  apiKeyId         String
  apiKey           ApiKey        @relation(fields: [apiKeyId], references: [id])
  mode             CheckoutMode
  listingId        String?
  quote            Json?
  clientSecretHash String
  status           SessionStatus @default(active)
  expiresAt        DateTime
  refreshCount     Int           @default(0)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  merchantId       String?
  merchant         Merchant?     @relation(fields: [merchantId], references: [id])
  counterpartyRef  String?

  @@index([apiKeyId])
  @@index([status])
  @@index([merchantId])
}

model WebhookEndpoint {
  id            String                @id @default(cuid())
  apiKeyId      String
  apiKey        ApiKey                @relation(fields: [apiKeyId], references: [id])
  url           String
  secret        String
  enabledEvents String[]
  status        WebhookStatus         @default(enabled)
  verified      Boolean               @default(false)
  description   String?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  deliveries    WebhookDelivery[]
  merchantId    String?
  merchant      Merchant?             @relation(fields: [merchantId], references: [id])

  @@index([apiKeyId])
  @@index([status])
  @@index([merchantId])
}

model WebhookEvent {
  id         String            @id @default(cuid())
  apiKeyId   String
  apiKey     ApiKey            @relation(fields: [apiKeyId], references: [id])
  type       String
  data       Json
  sourceEventId String? @unique
  createdAt  DateTime          @default(now())
  deliveries WebhookDelivery[]
  merchantId String?
  merchant   Merchant?         @relation(fields: [merchantId], references: [id])

  @@index([apiKeyId])
  @@index([type])
  @@index([merchantId])
}

model Subscription {
  id             String              @id @default(cuid())
  apiKeyId       String
  apiKey         ApiKey              @relation(fields: [apiKeyId], references: [id])
  sessionId      String
  payerRef       String?
  from           String
  to             String
  amount         Float
  asset          String              @default("USDC")
  interval       String
  status         SubscriptionStatus  @default(active)
  attemptCount   Int                 @default(0)
  failNextCharge Boolean             @default(false)
  nextChargeAt   DateTime
  canceledAt     DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  charges        SubscriptionCharge[]
  merchantId     String?
  merchant       Merchant?           @relation(fields: [merchantId], references: [id])

  @@index([apiKeyId])
  @@index([status, nextChargeAt])
  @@index([merchantId])
}

model SubscriptionCharge {
  id             String                   @id @default(cuid())
  subscriptionId String
  subscription   Subscription             @relation(fields: [subscriptionId], references: [id])
  status         SubscriptionChargeStatus
  quote          Json
  escrowId       String?
  failureReason  String?
  attempt        Int
  createdAt      DateTime                 @default(now())

  @@index([subscriptionId])
}

model WebhookDelivery {
  id             String                @id @default(cuid())
  endpointId     String
  endpoint       WebhookEndpoint       @relation(fields: [endpointId], references: [id])
  eventId        String
  event          WebhookEvent          @relation(fields: [eventId], references: [id])
  eventType      String
  status         WebhookDeliveryStatus @default(pending)
  attempts       Int                   @default(0)
  maxAttempts    Int                   @default(5)
  nextAttemptAt  DateTime              @default(now())
  lastError      String?
  lastStatusCode Int?
  deliveredAt    DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([status, nextAttemptAt])
  @@index([endpointId])
  @@index([eventId])
}

model IdempotencyRecord {
  id           String            @id @default(cuid())
  apiKeyId     String
  key          String
  requestHash  String
  status       IdempotencyStatus @default(pending)
  statusCode   Int?
  responseBody String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@unique([apiKeyId, key])
  @@index([createdAt])
}

model WebhookNonce {
  id        String   @id @default(cuid())
  nonce     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

model Escrow {
  id            String       @id
  apiKeyId      String
  apiKey        ApiKey       @relation(fields: [apiKeyId], references: [id])
  sessionId     String
  quoteId       String
  status        EscrowStatus @default(pending)
  amount        Float
  asset         String
  merchantId    String?
  merchant      Merchant?    @relation(fields: [merchantId], references: [id])
  cancelReason  String?
  cancelledAt   DateTime?
  cancelledBy   EscrowActor?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  refunds       EscrowRefund[]
  disputes      EscrowDispute[]

  @@index([apiKeyId, sessionId])
  @@index([status])
  @@index([merchantId])
}

model EscrowRefund {
  id        String      @id @default(cuid())
  escrowId  String
  escrow    Escrow      @relation(fields: [escrowId], references: [id])
  amount    Float
  reason    String
  actor     EscrowActor
  createdAt DateTime    @default(now())

  @@index([escrowId])
}

model EscrowDispute {
  id              String             @id @default(cuid())
  escrowId        String
  escrow          Escrow             @relation(fields: [escrowId], references: [id])
  status          DisputeStatus      @default(open)
  reason          String
  actor           EscrowActor
  evidenceRefs    String[]
  resolution      DisputeResolution?
  resolvedBy      EscrowActor?
  resolvedAt      DateTime?
  resolutionNote  String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([escrowId])
  @@index([status])
}

model SettlementPeriod {
  id         String                 @id @default(cuid())
  merchantId String
  merchant   Merchant               @relation(fields: [merchantId], references: [id])
  periodKey  String
  startsAt   DateTime
  endsAt     DateTime
  status     SettlementPeriodStatus @default(open)
  closedAt   DateTime?
  createdAt  DateTime               @default(now())

  ledgerEntries LedgerEntry[]
  payoutRuns    PayoutRun[]

  @@unique([merchantId, periodKey])
  @@index([merchantId])
  @@index([status])
}

model LedgerEntry {
  id               String          @id @default(cuid())
  merchantId       String
  merchant         Merchant        @relation(fields: [merchantId], references: [id])
  periodId         String
  period           SettlementPeriod @relation(fields: [periodId], references: [id])
  sourceEscrowId   String?
  direction        LedgerDirection
  kind             LedgerEntryKind
  amount           Float
  asset            String
  correctsEntryId  String?
  correctsEntry    LedgerEntry?    @relation("LedgerCorrection", fields: [correctsEntryId], references: [id])
  corrections      LedgerEntry[]   @relation("LedgerCorrection")
  occurredAt       DateTime
  createdAt        DateTime        @default(now())
  payoutRunId      String?
  payoutRun        PayoutRun?      @relation(fields: [payoutRunId], references: [id])

  @@index([merchantId])
  @@index([periodId])
  @@index([merchantId, asset, occurredAt])
  @@index([payoutRunId])
  @@index([sourceEscrowId])
}

model PayoutRun {
  id         String          @id @default(cuid())
  merchantId String
  merchant   Merchant        @relation(fields: [merchantId], references: [id])
  periodId   String
  period     SettlementPeriod @relation(fields: [periodId], references: [id])
  asset      String
  status     PayoutRunStatus @default(open)
  total      Float
  createdAt  DateTime        @default(now())
  finalizedAt DateTime?

  ledgerEntries LedgerEntry[]

  @@unique([merchantId, periodId, asset])
  @@index([merchantId])
  @@index([periodId])
}

// Per-merchant velocity thresholds. Every field is nullable: a null value
// means "use the platform default" (see src/risk/config.ts). Resolution is
// merchant-first, then platform default, field by field.
model MerchantRiskSettings {
  id                   String   @id @default(cuid())
  merchantId           String   @unique
  merchant             Merchant @relation(fields: [merchantId], references: [id])
  windowMs             Int?
  valueThreshold       Float?
  countThreshold       Int?
  reviewValueThreshold Float?
  reviewCountThreshold Int?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([merchantId])
}

// Per-merchant counterparty allow/deny lists, evaluated against the
// counterpartyRef carried on a CheckoutSession. A counterparty may not
// appear twice in the same list for the same merchant.
model MerchantRiskListEntry {
  id              String       @id @default(cuid())
  merchantId      String
  merchant        Merchant     @relation(fields: [merchantId], references: [id])
  listType        RiskListType
  counterpartyRef String
  note            String?
  createdAt       DateTime     @default(now())

  @@unique([merchantId, listType, counterpartyRef])
  @@index([merchantId])
  @@index([merchantId, listType])
}

// One row per risk evaluation performed on the escrow-creation path.
// allow/review rows count toward future velocity sums (real value moved);
// block rows do not (no escrow was created).
model RiskDecision {
  id              String              @id @default(cuid())
  merchantId      String
  merchant        Merchant            @relation(fields: [merchantId], references: [id])
  sessionId       String
  counterpartyRef String?
  amount          Float
  asset           String
  outcome         RiskDecisionOutcome
  reason          String
  requestId       String?
  createdAt       DateTime            @default(now())

  @@index([merchantId, createdAt])
  @@index([merchantId, outcome])
}
